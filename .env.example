# Copiar a .env y completar. Nunca subir .env al repo.
DATABASE_URL=sqlite:///./campus.db
AI_PROVIDER=gemini            # gemini | groq
GEMINI_API_KEY=
GROQ_API_KEY=
API_KEY=                     # si se define, /api exige el header X-API-Key
APP_ENV=development           # production oculta /docs y /openapi.json
INCIDENCIAS_POR_MINUTO=20
AI_TIMEOUT_SECONDS=10
AI_MAX_RETRIES=1
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1